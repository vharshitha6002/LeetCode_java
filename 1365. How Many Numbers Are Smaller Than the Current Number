class Solution {
    public int[] smallerNumbersThanCurrent(int[] nums) {
    int n = nums.length;
    int [] cum_sum = new int[101];
    
    for(int i = 0; i <= n-1; i++){
        cum_sum[nums[i]] += 1;
    }    
    for(int i = 1; i< cum_sum.length; i++){
        cum_sum[i] = cum_sum[i-1] + cum_sum[i];
    }
    int [] res = new int[n];
    for(int i = 0; i < n; i++){
        if(nums[i] != 0){
             res[i] = cum_sum[nums[i] - 1];
        }
    }
    return res;
    }
}
