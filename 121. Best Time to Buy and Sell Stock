class Solution {
    public int maxProfit(int[] prices) {
    int bp = prices[0];
    int profit = 0;
    int n = prices.length;
    for(int i = 1; i<= n-1; i++){
       // int x = prices[i];
        bp = Math.min(prices[i], bp);
        profit = Math.max((prices[i]-bp), profit);
    }    
    return profit;
    }
}
