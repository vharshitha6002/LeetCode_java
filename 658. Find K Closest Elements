class Solution {
    public List<Integer> findClosestElements(int[] arr, int k, int x) {
        List<Integer> res = new ArrayList<>();
        int n = arr.length;
        int low = 0;
        int high = n - 1;
        while((high - low + 1) > k){
            if((Math.abs(arr[low]-x)) > (Math.abs(arr[high]-x))){
                low++;
            }else{
                high--;
            }
        }
        for(int i = low; i <= high; i++){
            res.add(arr[i]);
        }
        return res;
    }
}
