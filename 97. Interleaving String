class Solution {
    public boolean isInterleave(String s1, String s2, String s3) {
    int m = s1.length();
    int n = s2.length();
    int s = s3.length();
    boolean[][] dp = new boolean[m +1][n + 1];
    if(m+n != s){
        return false;
    }
    dp[0][0] = true;
    for(int j = 1; j <= n; j++){
        boolean left = dp[0][j-1];
        if(left == true){
            if(s2.charAt(j-1) == s3.charAt(j-1)){
                dp[0][j] = true;
                }
            }
        }
        for(int i = 1; i <= m; i++){
            if(dp[i-1][0] == true){
                if(s1.charAt(i-1) == s3.charAt(i-1)){
                    dp[i][0] = true;
                }
            }
        }
        for(int i = 1; i <= m; i++){
            for(int j = 1; j <= n; j++){
                //boolean left = dp[0][j-1];
                //boolean top = dp[i-1][0];
                if(dp[i][j-1] == true){
                    if(s2.charAt(j-1) == s3.charAt(i+j-1)){
                        dp[i][j] = true;
                    }
                }
                if(dp[i-1][j] == true){
                    if(s1.charAt(i-1) == s3.charAt(i+j-1)){
                        dp[i][j] = true;
                    }
                }
            }
            }
            return dp[m][n];
        }  
    }
