class Solution {
    public int differenceOfSum(int[] nums) {
        int sum1 = 0;
        int sum2 = 0;
        for(int i = 0; i < nums.length; i++){
            sum1 += nums[i];
            int temp = nums[i];
            while (temp > 0){
                sum2 += temp%10;
                temp = temp/10;
            }
        }
        int res = Math.abs(sum1 - sum2);
        return res;
    }
}
